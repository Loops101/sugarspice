# Copy this file to ".env" and fill in what you need. Everything is optional for local use.

PORT=3000

# First-run admin account. If ADMIN_PASSWORD is empty, a random one is generated
# and printed in the console the first time the server starts.
ADMIN_EMAIL=admin@sugarspice.local
ADMIN_PASSWORD=

# Set a long random string in production. If empty, one is generated and saved in data/secret.key
JWT_SECRET=

# Public https address of the site (needed for live M-Pesa callbacks), e.g. https://www.yourdomain.co.ke
PUBLIC_URL=

# Where the database and uploaded images live. Point this at a persistent disk in production.
DATA_DIR=

# M-Pesa Daraja (STK Push). Leave blank to run in DEMO mode (payments auto-succeed after a few seconds).
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
# Random string used in the callback URL path so only Safaricom (who you give the URL to) can post to it
MPESA_CALLBACK_SECRET=

# Set to 1 when running behind a proxy / host such as Render, Railway, Fly or nginx
TRUST_PROXY=
NODE_ENV=development
